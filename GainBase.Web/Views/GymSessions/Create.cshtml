@model GymSessionCreateFormModel

@{
    ViewData["Title"] = "Log Gym Session";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h2 class="mb-0 fw-bold fs-4">Log Session - @Model.WorkoutName</h2>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <input asp-for="WorkoutId" type="hidden" />
                        <input asp-for="WorkoutName" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="SessionDate" class="form-label fw-semibold"></label>
                                <input asp-for="SessionDate" type="datetime-local" class="form-control rounded-3" />
                                <span asp-validation-for="SessionDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                                <input asp-for="DurationMinutes" class="form-control rounded-3" />
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Note" class="form-label fw-semibold">Note (Optional)</label>
                            <textarea asp-for="Note" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Note" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold mb-3">Exercise Logs</h5>
                        <div class="table-responsive mb-4">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Exercise</th>
                                        <th style="width:140px;">Sets</th>
                                        <th style="width:140px;">Reps</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ExerciseLogs.Count; i++)
                                    {
                                        <tr>
                                            <td>@Model.ExerciseLogs[i].ExerciseOrder</td>
                                            <td>
                                                @Model.ExerciseLogs[i].ExerciseName
                                                <input asp-for="ExerciseLogs[i].ExerciseId" type="hidden" />
                                                <input asp-for="ExerciseLogs[i].ExerciseName" type="hidden" />
                                                <input asp-for="ExerciseLogs[i].ExerciseOrder" type="hidden" />
                                            </td>
                                            <td>
                                                <input asp-for="ExerciseLogs[i].Sets" class="form-control rounded-3" />
                                                <span asp-validation-for="ExerciseLogs[i].Sets" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <input asp-for="ExerciseLogs[i].Reps" class="form-control rounded-3" />
                                                <span asp-validation-for="ExerciseLogs[i].Reps" class="text-danger small"></span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="SelectWorkout" class="btn btn-outline-secondary rounded-pill px-4">&larr; Back</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">Save Session</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}