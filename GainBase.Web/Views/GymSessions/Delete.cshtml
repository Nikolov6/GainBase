@model GymSessionDeleteViewModel

@{
    ViewData["Title"] = "Delete Session";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete Session</h3>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-4">Are you sure you want to delete this session? This action cannot be undone.</h5>

                    <dl class="row">
                        <dt class="col-sm-4">Workout</dt>
                        <dd class="col-sm-8">@Model.WorkoutName</dd>

                        <dt class="col-sm-4">Session Date</dt>
                        <dd class="col-sm-8">@Model.SessionDate</dd>

                        <dt class="col-sm-4">Duration</dt>
                        <dd class="col-sm-8">@Model.DurationMinutes min</dd>

                        <dt class="col-sm-4">Exercises</dt>
                        <dd class="col-sm-8">@Model.ExerciseCount</dd>
                    </dl>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex justify-content-between">
                            <a asp-action="MySessions" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>