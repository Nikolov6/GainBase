@{
    ViewData["Title"] = "500 Internal Server Error";
}

<div class="container text-center mt-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-1 text-danger fw-bold mb-3">500</h1>
            <h2 class="mb-4">Internal Server Error</h2>
            <p class="lead text-muted mb-5">
                We're sorry, but an unexpected error occurred on the server. Please try again later or contact support if the problem persists.
            </p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                Return to Home
            </a>
        </div>
    </div>
</div>