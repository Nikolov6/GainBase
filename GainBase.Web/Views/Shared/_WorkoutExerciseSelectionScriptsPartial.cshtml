<script>
    (function () {
        const form = document.querySelector('form[method="post"]');
        const checkboxes = Array.from(document.querySelectorAll('.exercise-checkbox'));
        const selectedCountElement = document.getElementById('selectedExercisesCount');
        const selectedExercisesContainer = document.getElementById('selectedExercisesContainer');
        const selectedExercisesOrder = document.getElementById('selectedExercisesOrder');
        const initialSelectedContainer = document.getElementById('initialSelectedExerciseIds');

        if (!form || !checkboxes.length || !selectedCountElement || !selectedExercisesContainer || !selectedExercisesOrder) {
            return;
        }

        const checkboxIdSet = new Set(checkboxes.map(c => c.dataset.exerciseId));
        const checkedIdsInDomOrder = checkboxes
            .filter(c => c.checked)
            .map(c => c.dataset.exerciseId);

        const seededIds = initialSelectedContainer
            ? Array.from(initialSelectedContainer.querySelectorAll('.selected-exercise-order-seed'))
                .map(i => i.value)
            : [];

        const validSeededIds = seededIds
            .filter(id => checkboxIdSet.has(id) && checkedIdsInDomOrder.includes(id));

        const missingCheckedIds = checkedIdsInDomOrder
            .filter(id => !validSeededIds.includes(id));

        let selectedExerciseIds = validSeededIds.length > 0
            ? [...validSeededIds, ...missingCheckedIds]
            : checkedIdsInDomOrder;

        function updateSelectedCount() {
            selectedCountElement.textContent = selectedExerciseIds.length.toString();
        }

        function renderSelectedOrder() {
            selectedExercisesOrder.innerHTML = '';

            selectedExerciseIds.forEach(id => {
                const checkbox = checkboxes.find(c => c.dataset.exerciseId === id);
                if (!checkbox) {
                    return;
                }

                const li = document.createElement('li');
                li.textContent = checkbox.dataset.exerciseName;
                selectedExercisesOrder.appendChild(li);
            });
        }

        function syncHiddenInputs() {
            selectedExercisesContainer.innerHTML = '';

            selectedExerciseIds.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'SelectedExerciseIds';
                input.value = id;
                selectedExercisesContainer.appendChild(input);
            });
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                const id = this.dataset.exerciseId;
                const existingIndex = selectedExerciseIds.indexOf(id);

                if (this.checked && existingIndex === -1) {
                    selectedExerciseIds.push(id);
                } else if (!this.checked && existingIndex !== -1) {
                    selectedExerciseIds.splice(existingIndex, 1);
                }

                updateSelectedCount();
                renderSelectedOrder();
                syncHiddenInputs();
            });
        });

        form.addEventListener('submit', syncHiddenInputs);

        updateSelectedCount();
        renderSelectedOrder();
        syncHiddenInputs();
    })();
</script>