@{
    ViewData["Title"] = "404 Not Found";
}

<div class="container text-center mt-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-1 text-danger fw-bold mb-3">404</h1>
            <h2 class="mb-4">Page Not Found</h2>
            <p class="lead text-muted mb-5">
                We're sorry, but the page you are looking for does not exist, has been removed, or is temporarily unavailable.
            </p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                Return to Home
            </a>
        </div>
    </div>
</div>