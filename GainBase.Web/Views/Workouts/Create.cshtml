@model WorkoutFormModel

@{
    ViewData["Title"] = "Create Workout";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h2 class="mb-0 fw-bold fs-4 text-center">@ViewData["Title"]</h2>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control rounded-3" placeholder="Workout Name" />
                            <label asp-for="Name">Workout Name</label>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control rounded-3" style="height:100px" placeholder="Description"></textarea>
                            <label asp-for="Description">Description (Optional)</label>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SelectedExerciseIds" class="form-label fw-semibold d-block">Exercises</label>

                            <div class="border rounded-3 p-3" style="max-height: 340px; overflow-y: auto;">
                                @foreach (var exercise in Model.AvailableExercises.OrderBy(e => e.Name))
                                {
                                    var isChecked = Model.SelectedExerciseIds.Contains(exercise.Id);

                                    <div class="form-check mb-2">
                                        <input class="form-check-input exercise-checkbox"
                                               type="checkbox"
                                               value="@exercise.Id"
                                               data-exercise-id="@exercise.Id"
                                               data-exercise-name="@exercise.Name"
                                               id="exercise_@exercise.Id"
                                               checked="@isChecked" />
                                        <label class="form-check-label" for="exercise_@exercise.Id">
                                            <span class="fw-semibold">@exercise.Name</span>
                                            <span class="text-muted">(@exercise.MuscleGroupName • @exercise.EquipmentName)</span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <div id="selectedExercisesContainer"></div>

                            <div class="form-text mt-2">
                                Selected: <span id="selectedExercisesCount">0</span>
                            </div>

                            <ol id="selectedExercisesOrder" class="small mt-2 ps-3"></ol>

                            <span asp-validation-for="SelectedExerciseIds" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="MyWorkouts" class="btn btn-outline-secondary rounded-pill px-4">&larr; Back</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">Create Workout</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_WorkoutExerciseSelectionScriptsPartial" />
}