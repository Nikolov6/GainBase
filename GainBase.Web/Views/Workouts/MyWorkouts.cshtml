@model IEnumerable<WorkoutMyViewModel>

@{
    ViewData["Title"] = "My Workouts";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">My Workouts</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">➕ Create Workout</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3">💪</div>
            <h3 class="text-muted fw-bold">No workouts created yet</h3>
            <p class="text-secondary">Build your first workout from the public exercise library.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 pb-5">
            @foreach (var workout in Model)
            {
                <div class="col">
                    <div class="card h-100 exercise-card shadow-sm">
                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="fw-bold text-dark mb-2">@workout.Name</h4>
                            <p class="text-muted mb-2">@(string.IsNullOrWhiteSpace(workout.Description) ? "No description provided." : workout.Description)</p>
                            <div class="small text-secondary mb-3">
                                Exercises: <strong>@workout.ExercisesCount</strong><br />
                                Created: <strong>@workout.CreatedAt</strong>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@workout.Id" class="btn btn-outline-dark rounded-pill flex-grow-1">
                                    View Details
                                </a>

                                <a asp-action="Edit" asp-route-id="@workout.Id" class="btn btn-warning rounded-pill">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@workout.Id" class="btn btn-danger rounded-pill">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>