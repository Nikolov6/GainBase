@using GainBase.Web.ViewModels.Exercise
@model IEnumerable<ExerciseMyViewModel>

@{
    ViewData["Title"] = "My Exercises";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3">📝</div>
            <h3 class="text-muted fw-bold">No uploaded exercises found</h3>
            <p class="text-secondary">Create your first exercise and share it with the community.</p>
            <a asp-action="Create" asp-controller="Exercises" class="btn btn-primary mt-3 px-4 rounded-pill">Create Exercise</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 pb-5">
            @foreach (var exercise in Model)
            {
                <div class="col">
                    <div class="card h-100 exercise-card shadow-sm">
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="fw-bold text-dark mb-0">@exercise.Name</h4>
                            </div>

                            <div class="mb-4">
                                <span class="badge bg-primary text-white px-3 py-2 rounded-pill me-2 mb-2 shadow-sm">
                                    @exercise.MuscleGroupName
                                </span>
                                <span class="badge bg-success text-white px-3 py-2 rounded-pill mb-2 shadow-sm">
                                    @exercise.EquipmentName
                                </span>
                                <div class="text-muted small mt-2">
                                    <i class="me-1">📅</i> Created on: @exercise.CreatedAt
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto pt-3 border-top border-light">
                                <a asp-action="Details" asp-controller="Exercises" asp-route-id="@exercise.Id"
                                   class="btn btn-outline-dark flex-grow-1 btn-rounded fw-medium">
                                    Details
                                </a>

                                <a asp-action="Edit" asp-controller="Exercises" asp-route-id="@exercise.Id"
                                   class="btn btn-warning btn-rounded px-3 shadow-sm h-100">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-controller="Exercises" asp-route-id="@exercise.Id"
                                   class="btn btn-danger btn-rounded px-3 shadow-sm h-100" title="Delete">
                                    Delete
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>