@using GainBase.Web.ViewModels.Exercise
@model ExerciseFormModel

@{
    ViewData["Title"] = "Edit Exercise";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 rounded-top-4">
                    <h2 class="mb-0 fw-bold fs-4 text-center">@ViewData["Title"]</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <p class="text-muted text-center mb-4">Update your exercise details below.</p>

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <partial name="_ExerciseFormFieldsPartial" model="Model" />

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="MyExercises" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                &larr; Back to My Exercises
                            </a>
                            <button type="submit" class="btn btn-warning px-5 py-2 fw-bold rounded-pill shadow-sm text-dark">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}