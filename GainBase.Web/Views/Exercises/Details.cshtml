@model ExerciseDetailsViewModel

@{
    ViewData["Title"] = "Exercise Details";
    string returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-dark text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
            <h2 class="mb-0 fw-bold fs-4">@Model.Name</h2>
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">⭐ @Model.FavoritesCount</span>
        </div>

        <div class="card-body p-4 p-md-5">
            <ul class="nav nav-tabs mb-4" id="exerciseDetailsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">
                        Overview
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="instructions-tab" data-bs-toggle="tab" data-bs-target="#instructions-pane" type="button" role="tab" aria-controls="instructions-pane" aria-selected="false">
                        Instructions
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="exerciseDetailsTabsContent">
                <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="text-muted small">Muscle Group</div>
                                <div class="fw-semibold">@Model.MuscleGroupName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="text-muted small">Equipment</div>
                                <div class="fw-semibold">@Model.EquipmentName</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="text-muted small">Created By</div>
                                <div class="fw-semibold">@Model.CreatorUserName</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="text-muted small">Created On</div>
                                <div class="fw-semibold">@Model.CreatedAt</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="text-muted small">Last Updated</div>
                                <div class="fw-semibold">@(Model.UpdatedAt ?? "Not updated")</div>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                    </p>
                </div>

                <div class="tab-pane fade" id="instructions-pane" role="tabpanel" aria-labelledby="instructions-tab" tabindex="0">
                    <h5 class="fw-bold mb-3">Step-by-step Instructions</h5>
                    <div class="p-3 border rounded-3 bg-light" style="white-space: pre-wrap;">@Model.Instructions</div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" asp-controller="Exercises" class="btn btn-outline-secondary rounded-pill px-4">
                    &larr; Back to Library
                </a>

                @if (Model.CanEdit)
                {
                    <a asp-action="Edit" asp-controller="Exercises" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 text-dark">
                        Edit
                    </a>
                }

                @if (Model.CanDelete)
                {
                    <a asp-action="Delete" asp-controller="Exercises" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4">
                        Delete
                    </a>
                }

                @if (Model.CanAddToFavorites)
                {
                    <form asp-action="AddToFavorites" asp-controller="Exercises" method="post" class="m-0">
                        <input type="hidden" name="exerciseId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-warning rounded-pill px-4">
                            ⭐
                        </button>
                    </form>
                }

                @if (Model.CanRemoveFromFavorites)
                {
                    <form asp-action="RemoveFromFavorites" asp-controller="Exercises" method="post" class="m-0">
                        <input type="hidden" name="exerciseId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            Remove from Favorites
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>