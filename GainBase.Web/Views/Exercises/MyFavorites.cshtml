@using GainBase.Web.ViewModels.Exercise
@model IEnumerable<ExerciseFavoriteViewModel>

@{
    ViewData["Title"] = "My Favorites";
}

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3">⭐</div>
            <h3 class="text-muted fw-bold">No favorite exercises found</h3>
            <p class="text-secondary">Explore the library and start starring your favorites!</p>
            <a asp-action="Index" asp-controller="Exercises" class="btn btn-primary mt-3 px-4 rounded-pill">View Library</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 pb-5">
            @foreach (var exercise in Model)
            {
                <div class="col">
                    <div class="card h-100 exercise-card shadow-sm">
                        <div class="card-body p-4 d-flex flex-column">
                            
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="fw-bold text-dark mb-0">@exercise.Name</h4>
                            </div>
                            
                            <div class="mb-4">
                                <span class="badge badge-soft-primary px-3 py-2 rounded-pill me-2 mb-2">
                                    @exercise.MuscleGroupName
                                </span>
                                <span class="badge badge-soft-success px-3 py-2 rounded-pill mb-2">
                                    @exercise.EquipmentName
                                </span>
                            </div>

                            <div class="d-flex gap-2 mt-auto pt-3 border-top border-light">
                                <a asp-action="Details" asp-controller="Exercise" asp-route-id="@exercise.Id" 
                                   class="btn btn-outline-dark flex-grow-1 btn-rounded fw-medium">
                                    View Details
                                </a>
                                
                                <form asp-action="RemoveFromMyFavorites" asp-controller="Exercises" method="post" class="m-0">
                                    <input type="hidden" name="exerciseId" value="@exercise.Id" />
                                    <button type="submit" class="btn btn-danger btn-rounded px-3 shadow-sm h-100" title="Remove from Favorites">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                            
                        </div>
                    </div>
                </div>
            }
        </div>
    }