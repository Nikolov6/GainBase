@model AllExercisesQueryModel

@{
    ViewData["Title"] = "Admin - Exercises Management";
}

<div class="container mt-4">
    <partial name="_AlertPartial" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Exercises Management</h1>
            <p class="text-muted mb-0">Create, edit, and delete any exercise.</p>
        </div>
        <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Create" class="btn btn-primary">
            ➕ Create Exercise
        </a>
    </div>

    <form method="get" asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Index" class="row g-3 mb-4">
        <input type="hidden" asp-for="CurrentPage" value="1" />

        <div class="col-12 col-md-5">
            <label asp-for="MuscleGroupId" class="form-label fw-semibold">Muscle Group</label>
            <select asp-for="MuscleGroupId" asp-items="@(new SelectList(Model.MuscleGroups, "Id", "Name"))" class="form-select">
                <option value="">All muscle groups</option>
            </select>
        </div>

        <div class="col-12 col-md-5">
            <label asp-for="EquipmentId" class="form-label fw-semibold">Equipment</label>
            <select asp-for="EquipmentId" asp-items="@(new SelectList(Model.Equipment, "Id", "Name"))" class="form-select">
                <option value="">All equipment</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-grid align-self-end">
            <button type="submit" class="btn btn-dark">Filter</button>
        </div>
    </form>

    @if (!Model.Exercises.Any())
    {
        <div class="alert alert-info">No exercises found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Muscle Group</th>
                        <th>Equipment</th>
                        <th>Favorites</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ExerciseIndexViewModel exercise in Model.Exercises)
                    {
                        <tr>
                            <td>@exercise.Name</td>
                            <td>@exercise.MuscleGroupName</td>
                            <td>@exercise.EquipmentName</td>
                            <td>@exercise.FavoritesCount</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-outline-secondary btn-sm">Details</a>
                                <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-outline-warning btn-sm">Edit</a>
                                <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Delete" asp-route-id="@exercise.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Exercises pages">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="ExercisesManagement"
                       asp-action="Index"
                       asp-route-currentPage="@(Model.CurrentPage - 1)"
                       asp-route-muscleGroupId="@Model.MuscleGroupId"
                       asp-route-equipmentId="@Model.EquipmentId">Previous</a>
                </li>

                @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="ExercisesManagement"
                           asp-action="Index"
                           asp-route-currentPage="@pageNumber"
                           asp-route-muscleGroupId="@Model.MuscleGroupId"
                           asp-route-equipmentId="@Model.EquipmentId">@pageNumber</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="ExercisesManagement"
                       asp-action="Index"
                       asp-route-currentPage="@(Model.CurrentPage + 1)"
                       asp-route-muscleGroupId="@Model.MuscleGroupId"
                       asp-route-equipmentId="@Model.EquipmentId">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>