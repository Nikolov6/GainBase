@model ExerciseFormModel

@{
    ViewData["Title"] = "Admin - Create Exercise";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h2 class="mb-0 fw-bold fs-4 text-center">@ViewData["Title"]</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <partial name="~/Views/Shared/_ExerciseFormFieldsPartial.cshtml" model="Model" />

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                &larr; Back
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill shadow-sm">
                                Create Exercise
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}