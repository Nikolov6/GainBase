@model ExerciseDeleteViewModel

@{
    ViewData["Title"] = "Admin - Delete Exercise";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete Exercise</h3>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-4">Are you sure you want to delete this exercise?</h5>

                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Muscle Group</dt>
                        <dd class="col-sm-8">@Model.MuscleGroupName</dd>

                        <dt class="col-sm-4">Equipment</dt>
                        <dd class="col-sm-8">@Model.EquipmentName</dd>

                        <dt class="col-sm-4">Created At</dt>
                        <dd class="col-sm-8">@Model.CreatedAt</dd>

                        <dt class="col-sm-4">Favorites</dt>
                        <dd class="col-sm-8">@Model.FavoritesCount</dd>
                    </dl>

                    <form asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin" asp-controller="ExercisesManagement" asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>